# Q-MÉTIER Environment Configuration

# Database
POSTGRES_PASSWORD=secret
POSTGRES_DB=qmetier
DATABASE_URL=postgresql://postgres:secret@localhost:5432/qmetier

# Ollama
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_EMB=http://localhost:11434/api/embeddings
LLM_MODEL=thumbtack-codegen
EMB_MODEL=nomic-embed-text

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# Redis
REDIS_URL=redis://localhost:6379

# Container Registry
REGISTRY_URL=ghcr.io/qmetier

# Kubernetes
KUBECONFIG=~/.kube/config

# Prometheus
PROMETHEUS_URL=http://prometheus:9090

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_URL=http://telegram-bot:8080
