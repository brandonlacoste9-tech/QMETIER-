# DevisPro Environment Configuration
# Copy this file to .env and fill in your actual values

# Application Settings
PORT=3000
NODE_ENV=development

# RBQ API Configuration (Production)
RBQ_API_ENDPOINT=https://api.rbq.gouv.qc.ca/licenses
RBQ_API_KEY=your_rbq_api_key_here

# WhatsApp API Configuration
WHATSAPP_ENABLED=true
WHATSAPP_API_KEY=your_whatsapp_api_key_here
WHATSAPP_API_URL=https://api.whatsapp.com/send

# SMS Configuration (Twilio)
SMS_ENABLED=true
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15145551234

# Payment Gateway (Interac e-Transfer)
INTERAC_ENABLED=true
INTERAC_API_KEY=your_interac_api_key_here
COMMISSION_RATE=0.15

# Database (if switching from JSON to database)
# DATABASE_URL=mongodb://localhost:27017/devispro
# or
# DATABASE_URL=postgresql://user:password@localhost:5432/devispro

# Security
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_here

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Admin Credentials
ADMIN_EMAIL=admin@devispro.qc.ca
ADMIN_PASSWORD=change_this_password

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
